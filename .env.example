# Cloudflare R2 (S3-compatible API)
# Create a token at: https://dash.cloudflare.com/?to=/:account/r2/overview
# (R2 → Overview → Manage R2 API Tokens). Object Read is enough to serve publications.

# Cloudflare account ID (used to build R2_ENDPOINT)
R2_ACCOUNT_ID=

# S3 API credentials from the R2 API token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For an EU-jurisdiction bucket: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# R2's S3 API region is always "auto"
R2_REGION=auto

# Bucket name (for reference / upload tooling). Publications are requested as
# s3://<bucket>/<path-to-file.epub>
R2_BUCKET=nicole-b-publications
